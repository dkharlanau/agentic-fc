+def safe_log(prefix, value):
+    # Diagnostics must not turn a valid decision into a failed request.
+    try:
+        app.logger.info(prefix + json.dumps(value,separators=(',',':'),allow_nan=False))
+    except Exception:
+        pass
+
+
+def stream(commands, trace=None):
+    # Same serialization and generator response contract as the saved baseline.
+    text = json.dumps(commands,separators=(',',':'),allow_nan=False)
+    if trace is None:
+        yield text
+        return
+    serialized = time.perf_counter_ns()
+    before_yield_unix = time.time_ns()
+    before_yield = time.perf_counter_ns()
+    yield text
+    # The consumer may never resume the generator. This event is best effort.
+    # Yield/resume are local handoff boundaries, NOT network receipt or apply.
+    resumed = time.perf_counter_ns()
+    safe_log('NHITL_TIMING ', {
+        'schemaVersion': 1, 'traceId': trace['traceId'], 'stage': 'yield_resumed',
+        'serializedAfterEntryMs': (serialized-trace['entryMonoNs'])/1e6,
+        'beforeYieldUnixNs': before_yield_unix,
+        'beforeYieldAfterEntryMs': (before_yield-trace['entryMonoNs'])/1e6,
+        'yieldResumeWaitMs': (resumed-before_yield)/1e6,
+        'wireBytes': len(text.encode('utf-8')),
+        'networkReceivedUnixNs': None, 'serverAppliedUnixNs': None})
+

